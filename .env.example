# LexaSafe — Variables d'environnement
# Copier vers .env et remplir avec des valeurs sécurisées en production

# Application
# production : Redis obligatoire pour les challenges A2F (sinon 503 fail-closed)
APP_ENV=development

# Base de données (PostgreSQL 16 RLS)
DATABASE_URL=postgresql://lexa_user:secret_change_me_in_prod@localhost:5432/lexasafe_db

# Redis (rate limiting, A2F challenges, OTP)
REDIS_URL=redis://localhost:6379/0

# Clés de chiffrement (SÉPARÉES — ne jamais réutiliser)
JWE_SECRET_KEY=change-me-jwe-32-chars-minimum!!
APP_MASTER_KEY=change-me-master-key-32-chars!!
DB_ENCRYPTION_KEY=change-me-db-encryption-key!!

# SMTP OVH Email Pro (souverain France)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@lexasafe.fr

# CORS (domaines front)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ClamAV (scan fichiers)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Next.js apps (public)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Creative / AI (server-only secrets — never prefix with NEXT_PUBLIC_)
# Presence is exposed to /setup as booleans only (see apps/web/src/lib/ai/env.ts).
GEMINI_API_KEY=
LUMA_API_KEY=
MESHY_API_KEY=
# Optional model override for gemini.ts
# GEMINI_MODEL=gemini-2.0-flash

# ByteDance Seedance 1.5 Pro via @fal-ai/client (fal.subscribe)
# Official key name: FAL_KEY. Alias: SEEDANCE_API_KEY.
# Signup: https://fal.ai/models/fal-ai/bytedance/seedance/v1.5/pro/text-to-video
# Keys: https://fal.ai/dashboard/keys
# BytePlus ModelArk (often gated): https://docs.byteplus.com/en/docs/ModelArk/what_is_modelark
# Volcengine Ark (CN, often gated): https://www.volcengine.com/docs/82379
SEEDANCE_API_KEY=
FAL_KEY=
ARK_API_KEY=
# SEEDANCE_PROVIDER=fal
# SEEDANCE_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDANCE_ARK_MODEL=seedance-1-5-pro-251215
# SEEDANCE_ALLOW_HTTP=true
